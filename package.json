{
  "name": "ipfs-webui",
  "version": "4.13.0",
  "type": "module",
  "private": true,
  "files": [
    "src",
    "public",
    "@types",
    "docs",
    "build"
  ],
  "scripts": {
    "start": "vite",
    "lint": "run-s eslint typecheck dep-check webmcp:vendor:check",
    "eslint": "eslint .",
    "prebuild": "node scripts/generate-locales.js",
    "build": "vite build",
    "build:icons": "svgr --ext tsx --typescript -d src/icons node_modules/ipfs-css/icons && eslint --fix src/icons/*.tsx",
    "dep-check": "node scripts/check-dependencies.js",
    "test": "run-s -cl test:unit test:build test:e2e",
    "test:unit": "vitest run",
    "test:unit:coverage": "vitest run --coverage",
    "test:unit:watch": "vitest",
    "test:e2e": "cross-env REACT_APP_ENV=test npx playwright test -c ./test/e2e",
    "test:build": "cross-env REACT_APP_ENV=test npm run build",
    "test:coverage": "vitest run --coverage",
    "storybook": "storybook dev -p 9009",
    "build-storybook": "storybook build",
    "serve-storybook": "run-s build-storybook && http-server storybook-static --port 6006",
    "test-storybook:ci": "concurrently -k -s first -n SB,TEST \"cross-env REACT_APP_ENV=test storybook build --quiet && http-server storybook-static --port 6006 --silent\" \"wait-on tcp:127.0.0.1:6006 && test-storybook --coverage\"",
    "typecheck": "tsc --noEmit",
    "webmcp:vendor": "node src/webmcp/vendor-webmcp.mjs ../kubo/mcp/webmcp/dist",
    "webmcp:vendor:check": "node src/webmcp/vendor-webmcp.mjs --check",
    "postinstall": "patch-package",
    "prestart": "node scripts/generate-locales.js",
    "preview": "vite preview --host 127.0.0.1 --port 3001 --strictPort",
    "analyze": "cross-env WEBUI_ANALYZE=true npm run build",
    "test:explorer": "vitest run src/explore",
    "check:explorer-freshness": "node vendor/ipld-explorer-components/scripts/check-freshness.mjs",
    "build:explorer-artifact": "node vendor/ipld-explorer-components/scripts/build-artifact.mjs",
    "prepare:explorer-artifact": "node scripts/prepare-explorer-artifact.mjs",
    "export:local": "node scripts/export-local-webui.mjs",
    "check:local-export": "node scripts/check-local-export.mjs",
    "test:agentic-boundary": "node scripts/agentic-boundary.mjs",
    "lint:roles": "node scripts/check-role-coverage.mjs"
  },
  "dependencies": {
    "@loadable/component": "5.16.7",
    "@multiformats/multiaddr": "12.5.1",
    "@multiformats/multiaddr-matcher": "1.4.0",
    "@multiformats/multiaddr-to-uri": "11.0.2",
    "@prometheus-ags/entity-graph-core": "4.2.0",
    "@prometheus-ags/entity-graph-react": "4.2.0",
    "@prometheus-ags/prometheus-entity-management": "4.2.0",
    "ace-builds": "1.45.0",
    "blueimp-md5": "2.19.0",
    "change-case": "3.1.0",
    "chart.js": "4.5.1",
    "classnames": "2.5.1",
    "countly-sdk-web": "19.8.0",
    "d3": "5.16.0",
    "datatransfer-files-promise": "1.3.1",
    "details-polyfill": "1.2.0",
    "file-extension": "4.0.5",
    "filesize": "6.4.0",
    "flag-icon-css": "3.3.0",
    "hashlru": "2.3.0",
    "i18next": "23.16.4",
    "i18next-browser-languagedetector": "8.0.0",
    "i18next-chained-backend": "3.1.0",
    "i18next-http-backend": "2.6.2",
    "i18next-icu": "2.3.0",
    "i18next-localstorage-backend": "3.1.3",
    "internal-nav-helper": "3.1.0",
    "intl-messageformat": "10.7.3",
    "ip": "1.1.9",
    "ipfs-css": "1.4.0",
    "ipfs-geoip": "9.3.0",
    "ipfs-provider": "2.1.0",
    "ipld-explorer-components": "file:vendor/ipld-explorer-components",
    "is-ipfs": "8.0.4",
    "istextorbinary": "6.0.0",
    "it-all": "1.0.6",
    "it-first": "1.0.7",
    "it-last": "1.0.6",
    "it-map": "1.0.6",
    "kubo-rpc-client": "6.1.0",
    "lucide-react": "1.57.0",
    "milliseconds": "1.0.3",
    "money-clip": "3.0.5",
    "multiformats": "13.4.0",
    "p-memoize": "4.0.4",
    "p-queue": "7.4.1",
    "prop-types": "15.8.1",
    "radix-ui": "1.7.0",
    "react": "19.3.1",
    "react-ace": "15.0.0",
    "react-chartjs-2": "5.3.1",
    "react-dnd": "16.0.1",
    "react-dnd-html5-backend": "16.0.1",
    "react-dom": "19.3.1",
    "react-hook-form": "7.90.0",
    "react-i18next": "15.1.0",
    "react-joyride": "3.2.0",
    "react-qr-code": "2.0.15",
    "react-virtualized": "10.0.0",
    "redux-bundler": "26.1.0",
    "tachyons": "4.12.0",
    "topojson-client": "3.1.0",
    "window-or-global": "1.0.1"
  },
  "devDependencies": {
    "@babel/core": "7.28.5",
    "@babel/eslint-parser": "7.28.5",
    "@ipld/dag-pb": "4.1.3",
    "@olizilla/lol": "2.0.0",
    "@playwright/test": "1.58.0",
    "@semantic-release/changelog": "6.0.3",
    "@semantic-release/commit-analyzer": "9.0.2",
    "@semantic-release/git": "10.0.1",
    "@semantic-release/github": "8.1.0",
    "@semantic-release/npm": "9.0.2",
    "@semantic-release/release-notes-generator": "10.0.3",
    "@storybook/addon-a11y": "10.6.3",
    "@storybook/addon-links": "10.6.3",
    "@storybook/react-vite": "10.6.3",
    "@storybook/test-runner": "0.26.0",
    "@svgr/cli": "8.1.0",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/blueimp-md5": "2.18.2",
    "@types/cytoscape": "3.21.8",
    "@types/cytoscape-dagre": "2.3.3",
    "@types/esm": "3.2.2",
    "@types/node": "26.6.4",
    "@types/path-browserify": "1.0.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/coverage-v8": "5.0.3",
    "autoprefixer": "10.4.20",
    "axe-core": "4.10.2",
    "basic-auth": "2.0.1",
    "big.js": "5.2.2",
    "concurrently": "7.6.0",
    "conventional-changelog-conventionalcommits": "5.0.0",
    "cross-env": "6.0.3",
    "depcheck": "1.4.7",
    "eslint": "8.57.1",
    "eslint-config-standard": "17.1.0",
    "eslint-plugin-import": "2.31.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-n": "15.7.0",
    "eslint-plugin-node": "11.1.0",
    "eslint-plugin-promise": "6.6.0",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-standard": "4.1.0",
    "fake-indexeddb": "3.1.8",
    "get-port": "5.1.1",
    "http-proxy": "1.18.1",
    "http-server": "14.1.1",
    "ipfsd-ctl": "15.0.2",
    "jsdom": "30.1.2",
    "kubo": "0.39.0",
    "npm-run-all": "4.1.5",
    "nyc": "15.1.0",
    "os-browserify": "0.3.0",
    "patch-package": "6.5.1",
    "path-browserify": "1.0.1",
    "playwright-chromium": "1.58.0",
    "postcss": "8.5.31",
    "postcss-flexbugs-fixes": "5.0.2",
    "react-dnd-test-backend": "16.0.1",
    "rollup-plugin-visualizer": "7.1.1",
    "semantic-release": "19.0.5",
    "storybook": "10.6.3",
    "stream-browserify": "3.0.0",
    "typescript": "7.0.2",
    "uint8arrays": "4.0.10",
    "vite": "8.3.4",
    "vite-plugin-istanbul": "9.0.1",
    "vite-plugin-node-polyfills": "0.28.0",
    "vitest": "5.0.3",
    "wait-on": "7.2.0"
  },
  "homepage": "./",
  "bundlesize": [
    {
      "path": "./build/static/*.js",
      "maxSize": "600 kB"
    },
    {
      "path": "./build/static/*.css",
      "maxSize": "18 kB"
    }
  ],
  "browserslist": [
    ">0.2%",
    "not dead",
    "not ie <= 11",
    "not op_mini all"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ipfs/ipfs-webui.git"
  },
  "release": {
    "branches": [
      "main"
    ],
    "plugins": [
      [
        "@semantic-release/commit-analyzer",
        {
          "preset": "conventionalcommits",
          "releaseRules": [
            {
              "breaking": true,
              "release": "major"
            },
            {
              "revert": true,
              "release": "patch"
            },
            {
              "type": "feat",
              "release": "minor"
            },
            {
              "type": "fix",
              "release": "patch"
            },
            {
              "type": "chore",
              "release": "patch"
            },
            {
              "type": "docs",
              "release": "patch"
            },
            {
              "type": "test",
              "release": "patch"
            },
            {
              "scope": "no-release",
              "release": false
            }
          ]
        }
      ],
      [
        "@semantic-release/release-notes-generator",
        {
          "config": "./custom-release-notes-generator.cjs",
          "presetConfig": {
            "types": [
              {
                "type": "feat",
                "section": "Features"
              },
              {
                "type": "fix",
                "section": "Bug Fixes"
              },
              {
                "type": "chore",
                "section": "Trivial Changes"
              },
              {
                "type": "docs",
                "section": "Trivial Changes"
              },
              {
                "type": "test",
                "section": "Tests"
              }
            ]
          }
        }
      ],
      "@semantic-release/changelog",
      [
        "@semantic-release/npm",
        {
          "npmPublish": false,
          "tarballDir": "dist"
        }
      ],
      [
        "@semantic-release/github",
        {
          "assets": [
            {
              "path": "ipfs-webui_*.car",
              "name": "ipfs-webui@${nextRelease.gitTag}.car",
              "label": "IPFS webui (${nextRelease.gitTag}) CAR file"
            }
          ]
        }
      ],
      "@semantic-release/git"
    ]
  },
  "overrides": {
    "@multiformats/multiaddr-matcher@1.4.0": {
      "@chainsafe/is-ip": "2.0.2"
    },
    "@multiformats/multiaddr": "$@multiformats/multiaddr",
    "multiformats": "$multiformats",
    "eventemitter3": "^5.0.1"
  },
  "engines": {
    "node": "^26.5.0"
  }
}
