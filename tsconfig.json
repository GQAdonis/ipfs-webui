{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "forceConsistentCasingInFileNames": true,
    "noImplicitReturns": true,
    "noImplicitAny": true,
    "noImplicitThis": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "strictFunctionTypes": true,
    "strictNullChecks": true,
    "strictPropertyInitialization": true,
    "strictBindCallApply": true,
    "strict": true,
    "skipLibCheck": true,
    "alwaysStrict": true,
    "esModuleInterop": true,
    "stripInternal": true,
    "resolveJsonModule": true,
    "preserveConstEnums": true,
    "removeComments": false,
    "target": "ES2022",
    "moduleResolution": "bundler",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "noEmitOnError": false,
    "noEmit": true,
    "emitDeclarationOnly": false,
    "declaration": false,
    "declarationMap": false,
    "incremental": true,
    "allowSyntheticDefaultImports": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "module": "esnext",
    "types": [
      "vite/client",
      "vitest/globals",
      "node"
    ],
    "paths": {
      "@gqadonis/ipfs-mcp-ui": [
        "../kubo/mcp/ui/dist/types/index.d.ts"
      ],
      "@gqadonis/ipfs-mcp-ui/host": [
        "../kubo/mcp/ui/dist/types/host/index.d.ts"
      ],
      "@gqadonis/ipfs-mcp-ui/a2ui": [
        "../kubo/mcp/ui/dist/types/a2ui/index.d.ts"
      ],
      "@gqadonis/ipfs-mcp-ui/styles.css": [
        "../kubo/mcp/ui/dist/ipfs-ui.css"
      ],
      "@gqadonis/ipfs-agent-chat/react": [
        "../kubo/mcp/chat/dist/types/react.d.ts"
      ],
      "ipld-explorer-components": [
        "./vendor/ipld-explorer-components/src/index.ts"
      ],
      "ipld-explorer-components/providers": [
        "./vendor/ipld-explorer-components/src/providers/index.ts"
      ],
      "ipld-explorer-components/pages": [
        "./vendor/ipld-explorer-components/src/pages.ts"
      ],
      "ipld-explorer-components/pages/start-exploring": [
        "./vendor/ipld-explorer-components/src/components/StartExploringPage.tsx"
      ],
      "ipld-explorer-components/forms": [
        "./vendor/ipld-explorer-components/src/forms.ts"
      ],
      "istextorbinary": [
        "./node_modules/istextorbinary/compiled-types/index.d.ts"
      ]
    },
    "allowImportingTsExtensions": true
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "@types/**/*",
    "src/bundles/files/**/*.js",
    "src/bundles/analytics.js",
    "src/bundles/config-save.js",
    "src/bundles/connected.js",
    "src/lib/enum.js",
    "src/bundles/experiments.js",
    "src/bundles/ipfs-desktop.js",
    "src/bundles/ipfs-provider.js",
    "src/agent-chat/session.js",
    "src/agent-chat/api-address.js",
    "src/bundles/retry-init.js",
    "src/bundles/local-storage.js",
    "src/bundles/task.js",
    "src/bundles/gateway.js",
    "src/lib/count-dirs.js",
    "src/lib/sort.js",
    "src/lib/files.js",
    "src/lib/share-link.js",
    "src/lib/ipfs-path.js",
    "src/env.js",
    "src/lib/hofs/**/*.js",
    "src/lib/guards.js",
    "src/files/type-from-ext/index.js",
    "src/files/file-icon/FileIcon.js",
    "src/files/pin-icon/PinIcon.js",
    "src/components/checkbox/Checkbox.js",
    "src/files/type-from-ext/extToType.js",
    "src/pins/**/*",
    "src/blank/**/*",
    "src/contexts/**/*",
    "src/constants/**/*",
    "src/helpers/**/*",
    "src/icons/**/*",
    "src/loader/**/*",
    "src/navigation/**/*",
    "src/welcome/**/*",
    "src/components/tour/withTour.js",
    "src/lib/tours.js",
    "src/components/is-connected/IsConnected.js",
    "src/components/is-not-connected/IsNotConnected.js",
    "src/components/about-ipfs/AboutIpfs.js",
    "src/components/about-webui/AboutWebUI.js",
    "src/components/box/Box.js",
    "src/components/shell/Shell.js",
    "src/i18n-decorator.js",
    "src/i18n.js",
    "src/lib/i18n-localeParser.js",
    "src/settings/Title.js",
    "src/promethity/brand-wordmark.js",
    "src/promethity/brand-p-icon.js",
    "src/promethity/brand.js",
    "src/promethity/icons.js",
    "src/promethity/page-title.js",
    "src/webmcp/*.js",
    "src/settings/agent/core/*.js",
    "src/agent-chat/endpoint.js",
    "src/search/client.js",
    "src/search/errors.js",
    "src/search/plain-text.js",
    "src/search/content-kinds.js",
    "src/search/format.js",
    "src/search/settings-store.js",
    "src/webmcp/vendor/**/*.d.ts"
  ],
  "exclude": [
    "src/webmcp/*.test.js",
    "src/settings/agent/**/*.test.js",
    "vendor/ipld-explorer-components/upstream/**"
  ]
}
